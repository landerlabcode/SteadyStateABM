Cell[BoxData[
 RowBox[{
  RowBox[{"systemB", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"c0", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"P2", "[", 
           RowBox[{
            RowBox[{"c0", "[", "t", "]"}], ",", 
