Cell["\<\
for the final case we need to switch from StepUpAsynchronousCF to \
StepUpAsynchronousCF2, because of the difference in the system:\
\>", "Text",
 CellChangeTimes->{{3.946998295524189*^9, 
  3.946998316223764*^9}},ExpressionUUID->"74123976-f515-45b7-b781-\
3b1e54f3092d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stochSim9", "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"params", "=", "params15"}], "}"}], ",", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Last", "@", 
         RowBox[{"Reap", "[", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"Sow", "[", 
             RowBox[{"TotalLast", "@", 
              RowBox[{"NestWhileList", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Apply", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"StepUpAsynchronousCF2", "[", 
                    RowBox[{"#1", ",", " ", "#2", ",", 
                    RowBox[{"pbar", "/.", "params"}], ",", 
                    RowBox[{"n1", "/.", "params"}], ",", " ", 
                    RowBox[{"n2", "/.", "params"}], ",", " ", 
                    RowBox[{"\[Gamma]", "/.", "params"}], ",", " ", 
                    RowBox[{"\[Phi]", "/.", "params"}], ",", " ", 
                    RowBox[{"d", "/.", "params"}]}], "]"}], "&"}], ",", "#"}],
                   "]"}], "&"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "0"}], "}"}], ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   SuperscriptBox["10", "4"], ">", 
                   RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&&", 
                  RowBox[{
                   RowBox[{"Last", "[", "#", "]"}], "<", 
                   SuperscriptBox["10", "4"]}]}], "&"}], ",", " ", "2", ",", 
                " ", "100"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", "100", "}"}]}], "]"}], "]"}]}], ",", "1"}], "]"}]}], 
     "]"}]}], ";"}], "]"}]], "Input",
 CellChangeTimes->{{3.946840799538962*^9, 3.946840874773592*^9}, {
   3.946840954028651*^9, 3.9468409861353073`*^9}, {3.946841045968473*^9, 
