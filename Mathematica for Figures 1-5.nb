Cell[CellGroupData[{

Cell["\<\
Theory and equations for \
\[OpenCurlyDoubleQuote]pseudo\[CloseCurlyDoubleQuote]-spatial models (Fig \
2I-P; Fig 4)\
\>", "Section",
 CellChangeTimes->{{3.89955360770079*^9, 3.89955360834581*^9}, {
   3.9468193468559923`*^9, 3.946819358500052*^9}, {3.947237873482182*^9, 
   3.9472378800247803`*^9}, {3.947353671369934*^9, 3.9473537052878942`*^9}, 
   3.9473537644618397`*^9},ExpressionUUID->"935bcb46-6fd2-47c5-9ddf-\
375b8279d921"],

Cell[TextData[{
 "Let c0 stand for dividing cells and c1 for terminal cells.  Our general \
functions for the growth of c0 and c1 are (in time units = cell cycle)\n\nc0\
\[CloseCurlyQuote][t] = (2p-1)c0[t],\nc1\[CloseCurlyQuote][t] = 2(1-p)c0[t] -\
\[Delta] c1[t]\n\n",
 StyleBox["For nonspatial models we use a Hill function formulation of p, \
typically:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.898980707458829*^9, 3.8989807271778183`*^9}, {
  3.899547630300262*^9, 3.899547632313252*^9}, {3.899553573711484*^9, 
  3.899553584044045*^9}, {3.8995536357101088`*^9, 3.899553740103199*^9}, {
  3.94735388094219*^9, 
  3.947353881779237*^9}},ExpressionUUID->"7be398a4-4078-4ffe-845c-\
d69a50ee6bd8"],

Cell[BoxData[
 RowBox[{"p", " ", "=", " ", 
  FractionBox["pbar", 
   RowBox[{"1", "+", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"c1", "[", "t", "]"}]}], ")"}], "n"]}]]}]], "Text",
 CellChangeTimes->{{3.899553742643691*^9, 3.8995537574650497`*^9}, 
   3.899553831222309*^9},ExpressionUUID->"282382ba-fc15-43c9-b2d4-\
9164ad87ec80"],

Cell["\<\
where \[Gamma] and n are positive constants, and pbar is a constant between \
0.5 and 1.\
\>", "Text",
 CellChangeTimes->{{3.899553765771051*^9, 
  3.8995537898782063`*^9}},ExpressionUUID->"8f53a948-09a6-4933-97ec-\
a7d33e1132d5"],

Cell[TextData[StyleBox["For \[OpenCurlyDoubleQuote]pseudo\
\[CloseCurlyDoubleQuote] spatial models we develop this theory:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.8989807305128403`*^9, 3.898980763573154*^9}, {
  3.898980797606722*^9, 3.898980875984535*^9}, {3.89941149617212*^9, 
  3.8994115491248302`*^9}, {3.899411719862526*^9, 3.899411733334158*^9}, {
  3.899553651470792*^9, 3.899553683457703*^9}, {3.899553791988379*^9, 
  3.899553801706531*^9}, {3.947353884153636*^9, 
  3.947353887273188*^9}},ExpressionUUID->"2621a55e-a4f4-48dc-acca-\
9620106f808c"],

Cell[TextData[{
 "1.  The function, in radial coordinates, for the steady-state, \
2-dimensional diffusion gradient within a disc of radius b, where production \
is uniform within the disc and zero elsewhere, and decay is uniform \
everywhere, may be found in Chen et al., 2016, and is:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{"b", " ", 
       TemplateBox[{"1", 
         FractionBox["b", "\[Lambda]"]},
        "BesselK"], " ", 
       TemplateBox[{"0", 
         FractionBox["r", "\[Lambda]"]},
        "BesselI"]}], "\[Lambda]"]}], ",", " ", 
    RowBox[{"r", "<", "b"}]}], TraditionalForm]], "Input",
  CellChangeTimes->{{3.947354252488627*^9, 3.947354255030541*^9}},
  FontWeight->"Plain",ExpressionUUID->
  "cb7bbf51-e8af-4474-83ef-68b28e181fe0"],
 "\nWhere r is radial distance and \[Lambda] is the decay length ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"D", "/", "k"}]], TraditionalForm]],ExpressionUUID->
  "9fe32d35-7612-4c30-b22a-51818d4564da"],
 " defined by diffusion coefficient ",
 StyleBox["D",
  FontSlant->"Italic"],
 " and decay rate constant ",
 StyleBox["k, I_",
  FontSlant->"Italic"],
 " is a modified Bessel function of the first kind and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", " ", 
    StyleBox["_",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64f39705-d9d7-4c7d-b205-1b38b23b01e9"],
 "is a modified Bessel function of the second kind.  .   \n\n2.  The radius \
of a disc with a total number of cells = \[Chi]  is found by taking the total \
Area dividing by \[Pi] and taking the square root.  If the radius of a cell \
is \[Sigma], then the area of each cell is \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],ExpressionUUID->
  "879906fb-f01b-4388-a167-66dad81014f0"],
 ", so the total area is \[Chi] \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],ExpressionUUID->
  "33e9e0eb-6441-49eb-8a7d-adee2236c17b"],
 ", therefore the radius of the disc is ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    FractionBox[
     RowBox[{"\[Chi]", " ", "\[Pi]", " ", 
      RowBox[{"\[Sigma]", "^", "2"}]}], "\[Pi]"]], TraditionalForm]],
  ExpressionUUID->"ef3571e0-41f7-4444-bd79-d6c9e33369a9"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", 
    SqrtBox["\[Chi]"]}], TraditionalForm]],ExpressionUUID->
  "77e0f5ca-6fb5-4952-ab41-110639bd2482"],
 "."
}], "Text",
 CellChangeTimes->{{3.898979982288557*^9, 3.898980054479549*^9}, {
  3.898980097515957*^9, 3.89898017608018*^9}, {3.89898023842457*^9, 
  3.898980408165462*^9}, {3.899411108238029*^9, 3.899411201666453*^9}, {
  3.899411241420903*^9, 3.899411254166296*^9}, {3.899544816118618*^9, 
  3.89954482291188*^9}, {3.899553057589106*^9, 3.8995532364399023`*^9}, {
  3.9468606419610577`*^9, 3.946860646944621*^9}, {3.947354017599337*^9, 
  3.947354183481498*^9}, {3.947354262890544*^9, 
  3.9473542726092787`*^9}},ExpressionUUID->"83b489c9-f9e7-4cde-b9d5-\
89d9dc546177"],

Cell[TextData[{
 "If will use c1 to represent terminal cells and c0 to represent dividing \
cells:  Then the formula for the amount of feedback factor at any given point \
is \n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"v", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Sigma]", " ", 
           SqrtBox[
            RowBox[{"c0", "+", "c1"}]]}], ")"}], " ", 
         TemplateBox[{"0", 
           FractionBox["r", "\[Lambda]"]},
          "BesselI"], " ", 
         TemplateBox[{"1", 
           FractionBox[
            RowBox[{"\[Sigma]", " ", 
              SqrtBox[
               RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]},
          "BesselK"]}], "\[Lambda]"]}], ")"}]}],
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.947353924292404*^9, 3.947353930268314*^9}},
  ExpressionUUID->"62cb6a04-f1b6-4a9f-9a30-2a2e6af2e873"],
 "\nwhere v is the rate of production.  If the factor is being made only by \
c1 cells, then the rate of production is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", " ", 
    RowBox[{"(", 
     FractionBox["c1", 
      RowBox[{"c0", "+", "c1"}]], ")"}]}], TraditionalForm]],ExpressionUUID->
  "18dc512e-59fe-45f5-a65a-a843cdf5e7bd"],
 ", where v is an arbitrary constant.  \nAccording to the formula p = ",
 Cell[BoxData[
  FormBox[
   FractionBox["pbar", 
    RowBox[{"1", "+", " ", 
     RowBox[{"F", "/", "\[Gamma]"}]}]], TraditionalForm]],ExpressionUUID->
  "9c029429-354d-4a51-9e1a-4826768f121b"],
 ", where F is the concentration of the secreted feedback factor,  the pvalue \
at any point r is thus:\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["pbar", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"c1", " ", "v"}], 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"(", 
          RowBox[{"c0", "+", "c1"}], ")"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Sigma]", " ", 
             SqrtBox[
              RowBox[{"c0", "+", "c1"}]]}], ")"}], " ", 
           TemplateBox[{"0", 
             FractionBox["r", "\[Lambda]"]},
            "BesselI"], " ", 
           TemplateBox[{"1", 
             FractionBox[
              RowBox[{"\[Sigma]", " ", 
                SqrtBox[
                 RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]},
            "BesselK"]}], "\[Lambda]"]}], ")"}]}], "+", "1"}]],
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.9473542966728487`*^9, 3.947354301197003*^9}},
  ExpressionUUID->"c02be996-f82c-44c4-838c-f6d92b133256"],
 "\nWe define k = \[Gamma]/v and re-write this as\n",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"k", " ", "pbar"}], 
    RowBox[{
     RowBox[{
      FractionBox["c1", 
       RowBox[{"c0", "+", "c1"}]], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Sigma]", " ", 
            SqrtBox[
             RowBox[{"c0", "+", "c1"}]]}], ")"}], " ", 
          TemplateBox[{"0", 
            FractionBox["r", "\[Lambda]"]},
           "BesselI"], " ", 
          TemplateBox[{"1", 
            FractionBox[
             RowBox[{"\[Sigma]", " ", 
               SqrtBox[
                RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]},
           "BesselK"]}], "\[Lambda]"]}], ")"}]}], "+", "k"}]], 
   TraditionalForm]],
  CellChangeTimes->{{3.9473542966728487`*^9, 3.947354301197003*^9}, {
   3.94735433642616*^9, 3.947354343109006*^9}},ExpressionUUID->
  "aa450b2c-aec5-4045-9751-5c431fa7a79c"],
 "\n\nNote that k represents 1/feedback strength, i.e. the lower the k the \
stronger the feedback.\n\n3. Getting the average pvalue over an entire disc\n\
To get the average pvalue, we must integrate p over the disc, which means we \
multiply by 2\[Pi] r and take the integral from 0 to the overall radius, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", 
    SqrtBox["\[Chi]"]}], TraditionalForm]],ExpressionUUID->
  "f7d1d287-9b91-40c3-9a5f-8732496ee40c"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", 
    SqrtBox[
     RowBox[{"c0", "+", "c1"}]]}], TraditionalForm]],ExpressionUUID->
  "ed403bab-88a5-4d6a-9405-5444f79a02df"],
 ", and then divide by the area of the disc, which is \[Pi] ( ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{
     RowBox[{"\[Sigma]", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"c0", " ", "+", " ", "c1"}], "]"}]}], ")"}], "2"], 
   TraditionalForm]],ExpressionUUID->"ed82c553-703c-4924-ad4d-72ec6c4d6a4b"],
 ".   Ultimately we get \n\n",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    RowBox[{"\[Pi]", " ", 
     SuperscriptBox["\[Sigma]", "2"], 
     RowBox[{"(", 
      RowBox[{"c0", "+", "c1"}], ")"}]}]], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", "\[Pi]", " ", "r", "*", "k", "*", " ", "pbar"}], 
      RowBox[{"k", "+", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["c1", 
          RowBox[{"c0", "+", "c1"}]], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           FractionBox[
            RowBox[{"\[Sigma]", 
             SqrtBox[
              RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"], "*", 
           RowBox[{"BesselI", "[", 
            RowBox[{"0", ",", 
             FractionBox["r", "\[Lambda]"]}], "]"}], "*", 
           RowBox[{"BesselK", "[", 
            RowBox[{"1", ",", 
             FractionBox[
              RowBox[{"\[Sigma]", 
               SqrtBox[
                RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]}], "]"}]}]}], 
         ")"}]}]}]], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", 
       RowBox[{"\[Sigma]", 
        SqrtBox[
         RowBox[{"c0", "+", "c1"}]]}]}], "}"}]}], "]"}]}]],
  CellChangeTimes->{{3.856549446299323*^9, 3.856549446489204*^9}, {
   3.8989804198287992`*^9, 3.898980482885681*^9}, {3.898980524947373*^9, 
   3.898980567046343*^9}, {3.899411276661742*^9, 3.899411434893537*^9}, {
   3.899411467125327*^9, 3.8994114877769814`*^9}, {3.8994576946052847`*^9, 
   3.8994576971612997`*^9}, {3.899458321513092*^9, 3.899458323510236*^9}},
  ExpressionUUID->"931c11fd-b13e-4fa0-b18b-818454a945c5"],
 "\n\npulling constants 2 \[Pi] pbar out of the numerator of the integrand, \
we get the following formula for p"
}], "Text",
 CellChangeTimes->{
  3.856549347996463*^9, {3.85654944187932*^9, 3.8565494455021057`*^9}, {
   3.856550260370474*^9, 3.856550272256654*^9}, {3.898980058459166*^9, 
   3.898980096543687*^9}, {3.8989806129209127`*^9, 3.898980628796941*^9}, {
   3.899411264501751*^9, 3.899411270957646*^9}, {3.899458336639873*^9, 
   3.899458693394875*^9}, {3.899459792182579*^9, 3.899459852434362*^9}, {
   3.899459940581566*^9, 3.8994599457845793`*^9}, {3.89946022949967*^9, 
   3.899460354858836*^9}, {3.89946039281439*^9, 3.8994604390653887`*^9}, {
   3.89955325666609*^9, 3.899553350045938*^9}, {3.899553415926721*^9, 
   3.899553512144462*^9}, {3.946860566800351*^9, 3.9468605675955753`*^9}, {
   3.946860791315599*^9, 3.946860792137892*^9}, {3.947353914209045*^9, 
   3.947353914219157*^9}, 3.947353946930489*^9, 3.94735432628284*^9, {
   3.947354373624938*^9, 
   3.94735442339685*^9}},ExpressionUUID->"88705716-ef45-46b8-8050-\
dcbe615b081f"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"2", "pbar"}], 
   RowBox[{
    SuperscriptBox["\[Sigma]", "2"], 
    RowBox[{"(", 
     RowBox[{"c0", "+", "c1"}], ")"}]}]], 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", 
    RowBox[{"\[Sigma]", 
     SqrtBox[
      RowBox[{"c0", "+", "c1"}]]}]], 
   RowBox[{
    FractionBox[
     RowBox[{" ", 
      RowBox[{"r", "*", "k"}]}], 
     RowBox[{"k", "+", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["c1", 
         RowBox[{"c0", "+", "c1"}]], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Sigma]", 
            SqrtBox[
             RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"], "*", 
          RowBox[{"BesselI", "[", 
           RowBox[{"0", ",", 
            FractionBox["r", "\[Lambda]"]}], "]"}], "*", 
          RowBox[{"BesselK", "[", 
           RowBox[{"1", ",", 
            FractionBox[
             RowBox[{"\[Sigma]", 
              SqrtBox[
               RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]}], "]"}]}]}], 
        ")"}]}]}]], 
    RowBox[{"\[DifferentialD]", "r"}]}]}]}]], "Text",
 CellChangeTimes->{{3.899554979101756*^9, 
  3.89955501420687*^9}},ExpressionUUID->"be5d08a7-ae19-4bf0-bfa7-\
409cee12cfff"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"P", "[", 
     RowBox[{
      RowBox[{"c0_", "?", "NumericQ"}], ",", 
      RowBox[{"c1_", "?", "NumericQ"}], ",", "k_", ",", "\[Lambda]_", ",", 
      "\[Sigma]_", ",", " ", "pbar_"}], "]"}], ":=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "pbar"}], 
      RowBox[{
       SuperscriptBox["\[Sigma]", "2"], 
       RowBox[{"(", 
        RowBox[{"c0", "+", "c1"}], ")"}]}]], 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       FractionBox[
        RowBox[{" ", 
         RowBox[{"r", "*", "k"}]}], 
        RowBox[{"k", "+", 
         RowBox[{
          RowBox[{"(", 
           FractionBox["c1", 
            RowBox[{"c0", "+", "c1"}]], ")"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Sigma]", 
               SqrtBox[
                RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"], "*", 
             RowBox[{"BesselI", "[", 
              RowBox[{"0", ",", 
               FractionBox["r", "\[Lambda]"]}], "]"}], "*", 
             RowBox[{"BesselK", "[", 
              RowBox[{"1", ",", 
               FractionBox[
                RowBox[{"\[Sigma]", 
                 SqrtBox[
                  RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]}], "]"}]}]}], 
           ")"}]}]}]], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", 
         RowBox[{"\[Sigma]", 
          SqrtBox[
           RowBox[{"c0", "+", "c1"}]]}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.856549446299323*^9, 3.856549446489204*^9}, {
  3.8989804198287992`*^9, 3.898980482885681*^9}, {3.898980524947373*^9, 
  3.898980567046343*^9}, {3.899411276661742*^9, 3.899411434893537*^9}, {
  3.899411467125327*^9, 3.8994114877769814`*^9}, {3.8994576946052847`*^9, 
  3.8994576971612997`*^9}, {3.899458321513092*^9, 3.899458323510236*^9}, {
  3.899458697764736*^9, 3.899458704713952*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[1509]:=",ExpressionUUID->"1f154d57-cc25-4caa-a4a1-083e5d8b8763"],

Cell[TextData[StyleBox["For spatial models in which cells sort away from each \
other",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.899553912470052*^9, 
  3.899553922561954*^9}},ExpressionUUID->"765b51bb-cad0-4ca9-a385-\
8974a0a0adba"],

Cell["\<\
Here we must calculate the diffusion gradients within just the regions that \
contain dividing cells, and average the p value just there.  \
\>", "Text",
 CellChangeTimes->{{3.899553950794806*^9, 
  3.8995540016036673`*^9}},ExpressionUUID->"c4dd7795-e738-4b73-a5a9-\
e9a067266f90"],

Cell[TextData[{
 "For this we will need to use the more complete equation from Chen et al., \
which gives the diffusion gradients both inside and outside discs that are \
producing a diffusible molecule.  \n\nInside:  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"1", "-", 
     RowBox[{
      FractionBox["b", "\[Lambda]"], " ", 
      TemplateBox[{"1", 
        FractionBox["b", "\[Lambda]"]},
       "BesselK"], " ", 
      TemplateBox[{"0", 
        FractionBox["r", "\[Lambda]"]},
       "BesselI"]}]}],
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.947354486234416*^9, 3.947354492163475*^9}},
  ExpressionUUID->"8c2e2d7f-b43d-4257-9895-12160c52de7e"],
 "\nOutside:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["b", "\[Lambda]"], " ", 
    TemplateBox[{"1", 
      FractionBox["b", "\[Lambda]"]},
     "BesselI"], " ", 
    TemplateBox[{"0", 
      FractionBox["r", "\[Lambda]"]},
     "BesselK"]}], TraditionalForm]],
  CellChangeTimes->{{3.9473545157213173`*^9, 3.947354521931129*^9}},
  ExpressionUUID->"3a0716f1-2c06-40c0-8bab-2718b6318a7f"]
}], "Text",
 CellChangeTimes->{{3.899554098632378*^9, 3.899554215109733*^9}, {
  3.947354500124609*^9, 
  3.947354549689501*^9}},ExpressionUUID->"65f17389-ef26-483c-8287-\
ec565e3a95ed"],

Cell[TextData[{
 StyleBox["Case 1:",
  FontWeight->"Bold"],
 "  ",
 StyleBox["Dividing cells are on the outside of the disc and terminal cells \
are on the inside",
  Background->RGBColor[0.87, 0.94, 1]],
 ".  We this have two radii to deal with, b1 is the radius of the disc formed \
by terminal cells, b2 is the radius of the entire disc.  We note that b1 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", 
    SqrtBox["c1"]}], TraditionalForm]],ExpressionUUID->
  "e5b75025-a4ee-4103-8f36-0b0163e71560"],
 ", whereas b2 = ",
 Cell[BoxData[
  RowBox[{"\[Sigma]", 
   SqrtBox[
    RowBox[{"c0", "+", "c1"}]]}]],
  CellChangeTimes->{{3.856549446299323*^9, 3.856549446489204*^9}, {
   3.8989804198287992`*^9, 3.898980482885681*^9}, {3.898980524947373*^9, 
   3.898980567046343*^9}, {3.899411276661742*^9, 3.899411434893537*^9}, {
   3.899411467125327*^9, 3.8994114877769814`*^9}, {3.8994576946052847`*^9, 
   3.8994576971612997`*^9}, {3.899458321513092*^9, 3.899458323510236*^9}, {
   3.899458697764736*^9, 3.899458704713952*^9}},ExpressionUUID->
  "d87841b9-b12d-49c4-87da-7821e9e6877a"],
 "\n\nIn this case, the gradient we need to average over is an outside \
gradient from b1 (and all the cells are producing in it), and we need to \
average p from b1 to b2.  Thus the p value at any point r, (between b1 and \
b2) is \n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{"k", " ", "pbar"}], 
     RowBox[{
      RowBox[{
       FractionBox["b1", "\[Lambda]"], " ", 
       TemplateBox[{"1", 
         FractionBox["b1", "\[Lambda]"]},
        "BesselI"], " ", 
       TemplateBox[{"0", 
         FractionBox["r", "\[Lambda]"]},
        "BesselK"]}], "+", "k"}]],
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.947354574614809*^9, 3.94735460764009*^9}},
  ExpressionUUID->"4c13e01f-dfea-4d80-a3c1-983457feaa08"],
 " ->",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{"k", " ", "pbar"}], 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SqrtBox["c1"], " ", "\[Sigma]"}], "\[Lambda]"], ")"}], " ", 
       TemplateBox[{"0", 
         FractionBox["r", "\[Lambda]"]},
        "BesselK"], " ", 
       TemplateBox[{"1", 
         FractionBox[
          RowBox[{"\[Sigma]", " ", 
            SqrtBox["c1"]}], "\[Lambda]"]},
        "BesselI"]}], "+", "k"}]],
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.947354574614809*^9, 3.9473546684593782`*^9}},
  ExpressionUUID->"c58757f8-b02a-4211-9f3d-0fb021be8a76"],
 " "
}], "Text",
 CellChangeTimes->{{3.899554010972437*^9, 3.8995540697134657`*^9}, {
   3.8995542304262733`*^9, 3.8995543532474117`*^9}, {3.8995543845822887`*^9, 
   3.899554527088426*^9}, {3.899554700687042*^9, 3.899554704791601*^9}, 
   3.947354615784124*^9, {3.9473546759165154`*^9, 
   3.947354689966091*^9}},ExpressionUUID->"55190448-69d7-4410-8a95-\
5cb191fe3d86"],

Cell[TextData[{
 "So we need to integrate this, multiplied by 2\[Pi]r,  from r=b1 to r=b2, \
and then divide by the area of the annulus between b1 and b2, which is \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b2", "2"], TraditionalForm]],ExpressionUUID->
  "4f565e69-3ae6-4309-8fd2-137d69712a9e"],
 "-\[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b1", "2"], TraditionalForm]],ExpressionUUID->
  "8dfb7751-8b3f-45ce-8b77-2effe4988bfe"],
 " = \n\[Pi] (",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[Sigma]", "2"], 
   RowBox[{"(", 
    RowBox[{"c0", "+", "c1"}], ")"}]}]],
  CellChangeTimes->{{3.856549446299323*^9, 3.856549446489204*^9}, {
   3.8989804198287992`*^9, 3.898980482885681*^9}, {3.898980524947373*^9, 
   3.898980567046343*^9}, {3.899411276661742*^9, 3.899411434893537*^9}, {
   3.899411467125327*^9, 3.8994114877769814`*^9}, {3.8994576946052847`*^9, 
   3.8994576971612997`*^9}, {3.899458321513092*^9, 3.899458323510236*^9}, {
   3.899458697764736*^9, 3.899458704713952*^9}},ExpressionUUID->
  "6d9a7986-3a79-4856-b69b-bcc3fa54b762"],
 " - ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", "2"], "c1"}], TraditionalForm]],ExpressionUUID->
  "b311a725-c24e-459f-920c-728db722fa6c"],
 ") = ",
 Cell[BoxData[
  RowBox[{"c0", " ", "\[Pi]", " ", 
   SuperscriptBox["\[Sigma]", "2"]}]],
  CellChangeTimes->{3.8995547778567533`*^9},ExpressionUUID->
  "7aed21b9-2477-4a09-b0e0-fa8aab619fb9"],
 ".  Pulling out pbar gives us:"
}], "Text",
 CellChangeTimes->{{3.89955462559614*^9, 3.899554684892107*^9}, {
  3.8995547301778183`*^9, 3.899554795560403*^9}, {3.899554840727956*^9, 
  3.899554846438871*^9}},ExpressionUUID->"d4ae1d95-2a36-4cec-9817-\
c404266868b8"],

Cell[BoxData[
 RowBox[{
  FractionBox["pbar", 
   RowBox[{"c0", " ", "\[Pi]", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]], 
  RowBox[{
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"\[Sigma]", 
     SqrtBox["c1"]}], 
    RowBox[{"\[Sigma]", 
     SqrtBox[
      RowBox[{"c0", "+", "c1"}]]}]], 
   RowBox[{
    FractionBox[
     RowBox[{"2", " ", "\[Pi]", " ", "k", " ", "r"}], 
     RowBox[{"k", "+", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[Sigma]", 
          SqrtBox["c1"]}], "\[Lambda]"], "*", 
        RowBox[{"BesselI", "[", 
         RowBox[{"1", ",", 
          FractionBox[
           RowBox[{"\[Sigma]", 
            SqrtBox["c1"]}], "\[Lambda]"]}], "]"}], "*", 
        RowBox[{"BesselK", "[", 
         RowBox[{"0", ",", 
          FractionBox["r", "\[Lambda]"]}], "]"}]}], ")"}]}]], 
    RowBox[{"\[DifferentialD]", "r"}]}]}]}]], "Text",
 CellChangeTimes->{{3.899555026596717*^9, 3.899555048007142*^9}, 
   3.8995555186039333`*^9, {3.946912847847083*^9, 
   3.94691284974254*^9}},ExpressionUUID->"95d3e97c-b30d-404c-b051-\
9f460f32632d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"P2", "[", 
   RowBox[{
    RowBox[{"c0_", "?", "NumericQ"}], ",", 
    RowBox[{"c1_", "?", "NumericQ"}], ",", "k_", ",", "\[Lambda]_", ",", 
    "\[Sigma]_", ",", " ", "pbar_"}], "]"}], ":=", " ", 
  RowBox[{
   FractionBox[
    RowBox[{"2", "pbar"}], 
    RowBox[{"c0", " ", 
     SuperscriptBox["\[Sigma]", "2"]}]], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"r", "*", "k"}], 
      RowBox[{"k", "+", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"\[Sigma]", 
           SqrtBox["c1"]}], "\[Lambda]"], "*", 
         RowBox[{"BesselI", "[", 
          RowBox[{"1", ",", 
           FractionBox[
            RowBox[{"\[Sigma]", 
             SqrtBox["c1"]}], "\[Lambda]"]}], "]"}], "*", 
         RowBox[{"BesselK", "[", 
          RowBox[{"0", ",", 
           FractionBox["r", "\[Lambda]"]}], "]"}]}], ")"}]}]], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"\[Sigma]", 
        SqrtBox["c1"]}], ",", " ", 
       RowBox[{"\[Sigma]", 
        SqrtBox[
         RowBox[{"c0", "+", "c1"}]]}]}], " ", "}"}]}], "]"}], 
   " "}]}]], "Input",
 CellChangeTimes->{{3.89955468930691*^9, 3.899554713074273*^9}, {
  3.89955480433512*^9, 3.899554850729732*^9}, {3.899554923447422*^9, 
  3.899554925336628*^9}, {3.8995555231604633`*^9, 3.899555554498817*^9}, {
  3.946912854650937*^9, 3.946912857259939*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[1507]:=",ExpressionUUID->"5681e7bf-a96c-4e73-98cb-55da8e344821"],

Cell[TextData[{
 StyleBox["Case 2 :",
  FontWeight->"Bold"],
 " ",
 StyleBox["Dividing cells are on the inside of the disc and terminal cells \
are on the outside",
  Background->RGBColor[0.87, 0.94, 1]],
 ".  We this have two radii to deal with, b1 is the radius of the disc formed \
by dividing cells, b2 is the radius of the entire disc.  We note that b1 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", 
    SqrtBox["c0"]}], TraditionalForm]],ExpressionUUID->
  "dbd24b72-4b11-4b9c-882c-5454efe075a8"],
 ", whereas b2 = ",
 Cell[BoxData[
  RowBox[{"\[Sigma]", 
   SqrtBox[
    RowBox[{"c0", "+", "c1"}]]}]],
  CellChangeTimes->{{3.856549446299323*^9, 3.856549446489204*^9}, {
   3.8989804198287992`*^9, 3.898980482885681*^9}, {3.898980524947373*^9, 
   3.898980567046343*^9}, {3.899411276661742*^9, 3.899411434893537*^9}, {
   3.899411467125327*^9, 3.8994114877769814`*^9}, {3.8994576946052847`*^9, 
   3.8994576971612997`*^9}, {3.899458321513092*^9, 3.899458323510236*^9}, {
   3.899458697764736*^9, 3.899458704713952*^9}},ExpressionUUID->
  "f5937ef9-9789-4194-8a77-7cabe93e20a0"],
 "\n\nIn this case, the gradient we need to average over is an inside \
gradient, which we obtain by first finding the inside gradient assuming all \
cells are c1 all the way out to b2, and then subtract the inside gradient we \
obtain when all cells are c1 going all the way out to b1.  We then average \
this gradient over the disc with radius b1.  "
}], "Text",
 CellChangeTimes->{{3.899555073644804*^9, 3.899555216685903*^9}, {
  3.899555267005265*^9, 
  3.899555270554257*^9}},ExpressionUUID->"4d4af8b9-5f7a-4337-bcae-\
65b2920adad4"],

Cell[TextData[{
 "The first gradient is thus  1- ",
 Cell[BoxData[
  FormBox[
   FractionBox["b2", "\[Lambda]"], TraditionalForm]],ExpressionUUID->
  "8920db72-5b41-4355-b561-d9fb6dd65cfd"],
 " BesselI[0,",
 Cell[BoxData[
  FormBox[
   FractionBox["r", "\[Lambda]"], TraditionalForm]],ExpressionUUID->
  "1b437134-649f-4f47-976c-694d57ed89a1"],
 "] BesselK[1,",
 Cell[BoxData[
  FormBox[
   FractionBox["b2", "\[Lambda]"], TraditionalForm]],ExpressionUUID->
  "80bee925-b23a-4c69-ae83-4864b03f505f"],
 "] and the gradient we subtract from it is 1- ",
 Cell[BoxData[
  FormBox[
   FractionBox["b1", "\[Lambda]"], TraditionalForm]],ExpressionUUID->
  "08222eb9-4a77-405c-b22c-91dfc11808b2"],
 " BesselI[0,",
 Cell[BoxData[
  FormBox[
   FractionBox["r", "\[Lambda]"], TraditionalForm]],ExpressionUUID->
  "f02bd10d-b7ef-48f1-b275-d0a691eb62c5"],
 "] BesselK[1,",
 Cell[BoxData[
  FormBox[
   FractionBox["b1", "\[Lambda]"], TraditionalForm]],ExpressionUUID->
  "2d4525b6-6bff-456e-8b7e-3ee57979dd18"],
 "].  Thus the true gradient is:"
}], "Text",
 CellChangeTimes->{{3.899555249741563*^9, 
  3.899555324924019*^9}},ExpressionUUID->"85a786de-61e6-430f-9d37-\
d50a9337c11e"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["b2", "\[Lambda]"], " ", 
        TemplateBox[{"1", 
          FractionBox["b2", "\[Lambda]"]},
         "BesselK"], " ", 
        TemplateBox[{"0", 
          FractionBox["r", "\[Lambda]"]},
         "BesselI"]}], "-", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          FractionBox["b1", "\[Lambda]"], " ", 
          TemplateBox[{"1", 
            FractionBox["b1", "\[Lambda]"]},
           "BesselK"], " ", 
          TemplateBox[{"0", 
            FractionBox["r", "\[Lambda]"]},
           "BesselI"]}]}], ")"}]}], 
      StyleBox[
       RowBox[{"/", "."}]], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b1", "->", 
         RowBox[{"\[Sigma]", " ", 
          SqrtBox["c0"]}]}], ",", " ", 
        RowBox[{"b2", "->", " ", 
         RowBox[{"\[Sigma]", 
          SqrtBox[
           RowBox[{"c0", "+", "c1"}]]}]}]}], "}"}]}], "]"}], " ", "which", 
    " ", "gives", " ", 
    RowBox[{"us", ":", "  "}]}],
   FontWeight->"Plain"], TraditionalForm]], "Input",
 CellChangeTimes->{{3.9473548567387667`*^9, 3.947354876123258*^9}, {
  3.94735492198512*^9, 
  3.947354962959545*^9}},ExpressionUUID->"3d39c9fe-7675-4550-99e9-\
5aaf753bb5cd"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{" ", 
    RowBox[{
     TemplateBox[{"0", 
       FractionBox["r", "\[Lambda]"]},
      "BesselI"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"\[Sigma]", 
          SqrtBox["c0"]}], "\[Lambda]"], " ", 
        TemplateBox[{"1", 
          FractionBox[
           RowBox[{
             SqrtBox["c0"], " ", "\[Sigma]"}], "\[Lambda]"]},
         "BesselK"]}], "-", 
       RowBox[{
        FractionBox[
         RowBox[{"\[Sigma]", 
          SqrtBox[
           RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"], " ", 
        TemplateBox[{"1", 
          FractionBox[
           RowBox[{"\[Sigma]", 
             SqrtBox[
              RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]},
         "BesselK"]}]}], ")"}]}]}],
   FontWeight->"Plain"], TraditionalForm]], "Input",
 CellChangeTimes->{{3.947354990560136*^9, 
  3.947355042252018*^9}},ExpressionUUID->"11e27c41-d665-4e78-8cf5-\
90118865d343"],

Cell[TextData[{
 "which means the pvalue is   ",
 Cell[BoxData[
  FractionBox[
   RowBox[{" ", 
    RowBox[{"k", " ", "pbar"}]}], 
   RowBox[{"k", "+", "  ", 
    RowBox[{
     StyleBox[
      TemplateBox[{"0", 
        FractionBox["r", "\[Lambda]"]},
       "BesselI"],
      FontWeight->"Plain"], 
     StyleBox[" ",
      FontWeight->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"\[Sigma]", 
          SqrtBox["c0"]}], "\[Lambda]"], " ", 
        TemplateBox[{"1", 
          FractionBox[
           RowBox[{
             SqrtBox["c0"], " ", "\[Sigma]"}], "\[Lambda]"]},
         "BesselK"]}], "-", 
       RowBox[{
        FractionBox[
         RowBox[{"\[Sigma]", 
          SqrtBox[
           RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"], " ", 
        TemplateBox[{"1", 
          FractionBox[
           RowBox[{"\[Sigma]", 
             SqrtBox[
              RowBox[{"c0", "+", "c1"}]]}], "\[Lambda]"]},
         "BesselK"]}]}], ")"}]}]}]]],
  CellChangeTimes->{{3.856549446299323*^9, 3.856549446489204*^9}, {
   3.8989804198287992`*^9, 3.898980482885681*^9}, {3.898980524947373*^9, 
   3.898980567046343*^9}, {3.899411276661742*^9, 3.899411434893537*^9}, {
   3.899411467125327*^9, 3.8994114877769814`*^9}, {3.8994576946052847`*^9, 
   3.8994576971612997`*^9}, {3.899458321513092*^9, 3.899458323510236*^9}, {
   3.899458697764736*^9, 3.899458704713952*^9}},ExpressionUUID->
  "ae758970-dca3-41ae-8655-f94cc2bd6dba"],
 "\nSo we need to integrate this, multiplied by 2\[Pi]r,  from r=0 to r=b1, \
and then divide by the area of \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b1", "2"], TraditionalForm]],ExpressionUUID->
  "84453097-2825-48a1-8c57-0c4cb414d881"],
 " = \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "2"], TraditionalForm]],ExpressionUUID->
  "9f3586af-c453-4f2b-ae67-ecf555b6ec9c"],
 "c0.  Pulling out the pbar gives us:\n"
}], "Text",
 CellChangeTimes->{{3.89955542288181*^9, 3.899555479361215*^9}, {
  3.89955558087288*^9, 3.899555669080912*^9}, {3.947355067164665*^9, 
  3.947355158695752*^9}},ExpressionUUID->"fc353c95-e7a2-4e09-8d43-\
f841d3edf814"],

Cell[BoxData[
 RowBox[{
  FractionBox["pbar", 
   RowBox[{"c0", " ", "\[Pi]", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]], 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", 
    RowBox[{"\[Sigma]", 
     SqrtBox["c0"]}]], 
   RowBox[{
    FractionBox[
     RowBox[{"2", " ", "\[Pi]", " ", "r", " ", "k", " "}], 
     RowBox[{"k", "+", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["\[Sigma]", "\[Lambda]"], " ", 
        RowBox[{"BesselI", "[", 
         RowBox[{"0", ",", 
          FractionBox["r", "\[Lambda]"]}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SqrtBox["c0"], " ", 
           RowBox[{"BesselK", "[", 
            RowBox[{"1", ",", 
             FractionBox[
              RowBox[{
               SqrtBox["c0"], " ", "\[Sigma]"}], "\[Lambda]"]}], "]"}]}], "-", 
          RowBox[{
           SqrtBox[
            RowBox[{"c0", "+", "c1"}]], " ", 
           RowBox[{"BesselK", "[", 
            RowBox[{"1", ",", 
             FractionBox[
              RowBox[{
               SqrtBox[
                RowBox[{"c0", "+", "c1"}]], " ", "\[Sigma]"}], "\[Lambda]"]}],
             "]"}]}]}], ")"}]}], ")"}]}]], 
    RowBox[{"\[DifferentialD]", "r"}]}]}]}]], "Text",
 CellChangeTimes->{{3.899555026596717*^9, 3.899555048007142*^9}, 
   3.8995555186039333`*^9, {3.8995556733722353`*^9, 3.899555690291843*^9}, {
   3.946912873561986*^9, 
   3.946912876498592*^9}},ExpressionUUID->"d57c0727-0fbe-4856-8c3c-\
0dd69ed72a0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"P3", "[", 
   RowBox[{
    RowBox[{"c0_", "?", "NumericQ"}], ",", 
    RowBox[{"c1_", "?", "NumericQ"}], ",", "k_", ",", "\[Lambda]_", ",", 
    "\[Sigma]_", ",", " ", "pbar_"}], "]"}], ":=", " ", 
  RowBox[{
   FractionBox[
    RowBox[{"2", " ", "pbar"}], 
    RowBox[{"c0", "  ", 
     SuperscriptBox["\[Sigma]", "2"]}]], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     FractionBox[
      RowBox[{" ", 
       RowBox[{"r", "*", "k", " "}]}], 
      RowBox[{"k", "+", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["\[Sigma]", "\[Lambda]"], " ", 
         RowBox[{"BesselI", "[", 
          RowBox[{"0", ",", 
           FractionBox["r", "\[Lambda]"]}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SqrtBox["c0"], " ", 
            RowBox[{"BesselK", "[", 
             RowBox[{"1", ",", 
              FractionBox[
               RowBox[{
                SqrtBox["c0"], " ", "\[Sigma]"}], "\[Lambda]"]}], "]"}]}], 
           "-", 
           RowBox[{
            SqrtBox[
             RowBox[{"c0", "+", "c1"}]], " ", 
            RowBox[{"BesselK", "[", 
             RowBox[{"1", ",", 
              FractionBox[
               RowBox[{
                SqrtBox[
                 RowBox[{"c0", "+", "c1"}]], " ", "\[Sigma]"}], 
               "\[Lambda]"]}], "]"}]}]}], ")"}]}], ")"}]}]], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", " ", 
       RowBox[{"\[Sigma]", 
        SqrtBox["c0"]}]}], " ", "}"}]}], "]"}], " "}]}]], "Input",
 CellChangeTimes->{{3.89955468930691*^9, 3.899554713074273*^9}, {
  3.89955480433512*^9, 3.899554850729732*^9}, {3.899554923447422*^9, 
  3.899554925336628*^9}, {3.8995555231604633`*^9, 3.899555554498817*^9}, {
  3.899555726416703*^9, 3.899555754919035*^9}, {3.946912894451558*^9, 
  3.946912913748287*^9}},
 Background->RGBColor[1, 1, 0],
 CellLabel->
  "In[1508]:=",ExpressionUUID->"edad42b8-f8e2-4be8-84a5-22916006dfbe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"systemA", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"c0", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"P1", "[", 
           RowBox[{
            RowBox[{"c0", "[", "t", "]"}], ",", 
            RowBox[{"c1", "[", "t", "]"}], ",", "k", ",", "\[Lambda]", ",", 
            " ", "\[Sigma]", ",", " ", "pbar"}], "]"}]}], "-", "1"}], ")"}], 
       RowBox[{"c0", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"c1", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"P1", "[", 
           RowBox[{
            RowBox[{"c0", "[", "t", "]"}], ",", " ", 
            RowBox[{"c1", "[", "t", "]"}], ",", "k", ",", "\[Lambda]", ",", 
            " ", "\[Sigma]", ",", " ", "pbar"}], "]"}]}], ")"}], 
        RowBox[{"c0", "[", "t", "]"}]}], " ", "-", 
       RowBox[{"\[Delta]", " ", 
        RowBox[{"c1", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c0", "[", "0", "]"}], "==", "c0init"}], ",", " ", 
     RowBox[{
      RowBox[{"c1", "[", "0", "]"}], "==", "c1init"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9468414667520733`*^9, 3.94684149423802*^9}},
 CellLabel->
  "In[1438]:=",ExpressionUUID->"9e482a44-6a8d-4500-bc78-6ad266735a67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"systemAa", "=", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"systemA", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "2"}], "]"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"c1", "[", "t", "]"}], "->", " ", 
           RowBox[{
            RowBox[{"s", "[", "t", "]"}], "-", 
            RowBox[{"c0", "[", "t", "]"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"c1", "'"}], "[", "t", "]"}], "->", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "'"}], "[", "t", "]"}], "-", 
            RowBox[{
             RowBox[{"c0", "'"}], "[", "t", "]"}]}]}]}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"c0", "'"}], "[", "t", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"s", "'"}], "[", "t", "]"}]}], "}"}]}], "]"}], "]"}], "]"}],
    "/.", 
   RowBox[{"Rule", "->", " ", "Equal"}]}]}]], "Input",
 CellChangeTimes->{{3.951396841200452*^9, 3.9513969239790087`*^9}},
 CellLabel->
