Cell[BoxData[
 RowBox[{
  RowBox[{"ChooseFate2", "[", 
   RowBox[{"x_", ",", " ", "\[Gamma]_", ",", " ", "n_", ",", " ", "p0_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{"x", "==", 
     RowBox[{"-", "1"}]}], ",", " ", 
