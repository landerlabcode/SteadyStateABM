Cell[BoxData[
 RowBox[{
  RowBox[{"systemA", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"c0", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"P1", "[", 
           RowBox[{
            RowBox[{"c0", "[", "t", "]"}], ",", 
            RowBox[{"c1", "[", "t", "]"}], ",", "k", ",", "\[Lambda]", ",", 
            " ", "\[Sigma]", ",", " ", "pbar"}], "]"}]}], "-", "1"}], ")"}], 
       RowBox[{"c0", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"c1", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"P1", "[", 
           RowBox[{
            RowBox[{"c0", "[", "t", "]"}], ",", " ", 
            RowBox[{"c1", "[", "t", "]"}], ",", "k", ",", "\[Lambda]", ",", 
            " ", "\[Sigma]", ",", " ", "pbar"}], "]"}]}], ")"}], 
        RowBox[{"c0", "[", "t", "]"}]}], " ", "-", 
       RowBox[{"\[Delta]", " ", 
        RowBox[{"c1", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c0", "[", "0", "]"}], "==", "c0init"}], ",", " ", 
     RowBox[{
      RowBox[{"c1", "[", "0", "]"}], "==", "c1init"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9468414667520733`*^9, 3.94684149423802*^9}},
 CellLabel->
  "In[1433]:=",ExpressionUUID->"021cd18f-92c2-4ec2-92df-70c8fa07f00f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fig2N", "=", "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", "=", "0.75"}], ",", " ", 
      RowBox[{"\[Lambda]", "=", "100"}], ",", " ", 
      RowBox[{"\[Sigma]", "=", "5"}], ",", " ", 
      RowBox[{"pbar", "=", "0.9"}], ",", " ", 
      RowBox[{"c0init", "=", "1"}], ",", " ", 
      RowBox[{"c1init", "=", "0"}], ",", " ", 
      RowBox[{"tend", "=", "200"}], ",", " ", 
      RowBox[{"\[Delta]", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"solset", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"NDSolve", "[", 
          RowBox[{"systemA", ",", " ", 
           RowBox[{"{", 
            RowBox[{"c0", ",", " ", "c1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "tend"}], "}"}]}], "]"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c1", "[", "t", "]"}], ",", " ", 
            RowBox[{"c0", "[", "t", "]"}]}], "}"}], "/.", "solset"}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "tend"}], "}"}], ",", " ", 
        RowBox[{"PlotStyle", "->", " ", 
         RowBox[{"Thickness", "[", "0.01", "]"}]}], ",", " ", 
        RowBox[{"ImageSize", "->", " ", "200"}], ",", " ", 
        RowBox[{"LabelStyle", "->", " ", "Medium"}]}], "]"}]}], "]"}]}], 
   "]"}]}]], "Input",
