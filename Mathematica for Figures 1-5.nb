Cell[BoxData[
 RowBox[{
  RowBox[{"IndividualStepUp", "[", 
   RowBox[{"{", 
    RowBox[{"c0_", ",", " ", "c1_"}], "}"}], "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", "=", 
      RowBox[{"pbar", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"\[Gamma]", "*", 
           SuperscriptBox["c1", "n1"]}], 
          RowBox[{"1", "+", 
           RowBox[{"\[Phi]", "*", 
            SuperscriptBox["c0", "n2"]}]}]]}], ")"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c0", "-", "1"}], ",", " ", "c1"}], "}"}], "+", 
     RowBox[{"RandomChoice", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["p", "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "p"}], ")"}], "2"], ",", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "p"}], ")"}], " ", "p"}]}], "}"}], "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}], " ", "}"}]}], "]"}], "-", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"BinomialDistribution", "[", 
         RowBox[{"c1", ",", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "k"}], "/", "c0"}]]}]}], " ", "]"}], "]"}]}], 
      "}"}]}]}], "]"}]}]], "Input",
