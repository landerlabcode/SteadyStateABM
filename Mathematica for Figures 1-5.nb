Cell[BoxData[
 RowBox[{
  RowBox[{"CreateOrganizedList3", "[", 
   RowBox[{
   "labeledarray_", ",", "basetable_", ",", " ", "iterations_", ",", " ", 
    "\[Lambda]_", ",", " ", "\[Gamma]_", ",", " ", "n_", ",", " ", "p0_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", "=", 
       RowBox[{
        RowBox[{"GrowthSimulation3", "[", 
         RowBox[{
         "#", ",", "basetable", ",", "\[Lambda]", ",", "\[Gamma]", ",", " ", 
          "n", ",", " ", "p0"}], "]"}], "&"}]}], " ", ",", " ", "step", ",", 
      " ", "steplist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"step", "=", 
      RowBox[{"Flatten", "[", "labeledarray", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"steplist", "=", 
      RowBox[{"{", "step", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"step", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Plus", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "&"}], "/@", 
             RowBox[{"Keys", "[", "step", "]"}]}], ")"}], "->", " ", 
           RowBox[{"(", 
            RowBox[{"f", "/@", 
             RowBox[{"Values", "[", "step", "]"}]}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"steplist", ",", " ", "step"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "i", ",", " ", "Now", ",", "\"\< still dividing = \>\"", ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"BoolEval", "[", 
                RowBox[{"#", "==", "1"}], "]"}], "[", 
               "\"\<ExplicitLength\>\"", "]"}], ")"}], "&"}], "/@", 
            RowBox[{"Values", "[", "step", "]"}]}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "iterations"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<done\>\"", "]"}], ";", "\[IndentingNewLine]", 
     "steplist"}]}], "]"}]}]], "Input",
