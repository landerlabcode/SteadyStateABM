Cell[BoxData[
 RowBox[{
  RowBox[{"IndividualStepUpP3", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c0_", ",", " ", "c1_"}], "}"}], ",", " ", "params_"}], "]"}], ":=",
   " ", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", "=", 
      RowBox[{"P3", "[", 
       RowBox[{"c0", ",", " ", "c1", ",", " ", 
        RowBox[{"k", "/.", "params"}], ",", " ", 
        RowBox[{"\[Lambda]", "/.", "params"}], ",", " ", 
        RowBox[{"\[Sigma]", "/.", "params"}], ",", " ", 
        RowBox[{"pbar", "/.", "params"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c0", "-", "1"}], ",", " ", "c1"}], "}"}], "+", 
     RowBox[{"RandomChoice", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["p", "2"], ",", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "p"}], ")"}], "2"], ",", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "p"}], ")"}], " ", "p"}]}], "}"}], "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}], " ", "}"}]}], "]"}], "-", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"BinomialDistribution", "[", 
         RowBox[{"c1", ",", 
          RowBox[{
           RowBox[{"1", "-", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "\[Delta]"}], "/", "c0"}]]}], " ", "/.", 
           "params"}]}], "]"}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
