Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "GrowthSimulation3", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Max Size\>\"", "->", " ", "75000"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GrowthSimulation3", "[", 
   RowBox[{
   "array_", ",", "basetable_", ",", "\[Lambda]_", ",", "  ", "\[Gamma]_", 
    ",", " ", "n_", ",", " ", "p0_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bounds", ",", " ", "searchspace", ",", "div", ",", " ", "diff", ",", 
      " ", "divs", ",", " ", "diffs", ",", " ", "diffusionfield", ",", 
      "newarray", ",", " ", "donor", ",", "recipient", ",", " ", 
      "elementlist", ",", " ", "neighbormatrix", ",", "i", ",", " ", 
      "shovedmat"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"div", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"BoolEval", "[", 
        RowBox[{"array", ">", " ", "0"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"diff", "=", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"BoolEval", "[", 
        RowBox[{"array", "==", " ", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", 
        RowBox[{"div", "[", "\"\<ExplicitLength\>\"", "]"}], "<", 
        RowBox[{"OptionValue", "[", "\"\<Max Size\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"diffusionfield", "=", 
         RowBox[{"DiffusionMap", "[", 
          RowBox[{"basetable", ",", " ", 
           RowBox[{"diff", "[", "\"\<ExplicitPositions\>\"", "]"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"newarray", "=", "\[IndentingNewLine]", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"Join", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"RandomSample", "[", 
                RowBox[{"div", "[", "\"\<ExplicitPositions\>\"", "]"}], "]"}],
                " ", "->", " ", 
               RowBox[{"N", "[", 
                RowBox[{"Range", "[", 
                 RowBox[{"div", "[", "\"\<ExplicitLength\>\"", "]"}], "]"}], 
                "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"diff", "[", "\"\<ExplicitPositions\>\"", "]"}], " ", "->",
                " ", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", 
                 RowBox[{"diff", "[", "\"\<ExplicitLength\>\"", "]"}]}], 
                "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"_", ",", "_"}], "}"}], "->", " ", "0"}], "}"}]}], 
            "]"}], ",", 
           RowBox[{"Dimensions", "[", "array", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"elementlist", "=", "\[IndentingNewLine]", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Apply", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"diffusionfield", "[", 
                RowBox[{"[", "##", "]"}], "]"}], "&"}], ",", "#"}], "]"}], 
            "&"}], ",", " ", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"Range", "[", 
              RowBox[{"div", "[", "\"\<ExplicitLength\>\"", "]"}], "]"}], 
             "]"}], "/.", 
            RowBox[{"(", 
             RowBox[{"Reverse", "/@", 
              RowBox[{"ArrayRules", "[", "newarray", "]"}]}], ")"}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", " ", 
          RowBox[{"i", "<=", " ", 
           RowBox[{"div", "[", "\"\<ExplicitLength\>\"", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"divs", "=", 
            RowBox[{
             RowBox[{"SparseArray", "[", 
              RowBox[{"BoolEval", "[", 
               RowBox[{"newarray", ">", " ", "0"}], "]"}], "]"}], "[", 
             "\"\<ExplicitPositions\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"diffs", "=", 
            RowBox[{
             RowBox[{"SparseArray", "[", 
              RowBox[{"BoolEval", "[", 
               RowBox[{"newarray", "==", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], "[", 
             "\"\<ExplicitPositions\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"bounds", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"MinMax", "[", 
                 RowBox[{"Union", "[", "#", "]"}], "]"}], "+", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "&"}], "/@", 
              RowBox[{"Transpose", "[", 
               RowBox[{"Join", "[", 
                RowBox[{"divs", ",", " ", "diffs"}], "]"}], "]"}]}], "]"}]}], 
           ";", " ", 
           RowBox[{"searchspace", "=", 
            RowBox[{"Complement", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"x", ",", " ", 
                    RowBox[{"bounds", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                    RowBox[{"bounds", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"y", ",", " ", 
                    RowBox[{"bounds", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
                    RowBox[{"bounds", "[", 
                    RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
                "1"}], "]"}], ",", 
              RowBox[{"newarray", "[", "\"\<ExplicitPositions\>\"", "]"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"donor", "=", 
            RowBox[{
             RowBox[{"N", "[", "i", "]"}], "/.", 
             RowBox[{"Reverse", "/@", 
              RowBox[{"ArrayRules", "[", "newarray", "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"recipient", "=", " ", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{"Nearest", "[", 
              RowBox[{"searchspace", ",", "donor"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"newarray", "=", 
            RowBox[{"SparseArray", "[", 
             RowBox[{"JustShoveCF", "[", 
              RowBox[{
               RowBox[{"Normal", "[", "newarray", "]"}], ",", 
               RowBox[{"elementlist", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "donor", ",", " ", 
               "recipient"}], "]"}], "]"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ChooseFate2", "[", 
            RowBox[{
            "#", ",", " ", "\[Gamma]", ",", " ", "n", ",", " ", "p0"}], "]"}],
            "&"}], ",", "newarray", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       "array"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.914498495867196*^9, 3.9144984962189493`*^9}},
