Cell[CellGroupData[{

Cell["With feedback (Fig. 1B)", "Subsection",
 CellChangeTimes->{{3.932827972047557*^9, 3.9328279760526247`*^9}, {
  3.951502642817391*^9, 
  3.951502659823995*^9}},ExpressionUUID->"78b5713c-ee09-4904-9d84-\
b141afcf9823"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stochSim", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Last", "@", 
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Sow", "[", 
          RowBox[{"TotalLast", "@", 
           RowBox[{"NestWhileList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Apply", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"StepUpAsynchronousCF", "[", 
                  RowBox[{
                  "#1", ",", " ", "#2", ",", "1", ",", "1", ",", " ", "0", 
                   ",", "0.001", ",", " ", "0", ",", "0.5"}], "]"}], "&"}], 
                ",", "#"}], "]"}], "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"500", ",", "1000"}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                SuperscriptBox["10", "4"], ">", 
                RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&&", 
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], "<", 
                SuperscriptBox["10", "4"]}]}], "&"}], ",", " ", "2", ",", " ",
              "200"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", "100", "}"}]}], "]"}], "]"}]}], ",", "1"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.946841129257*^9, 3.94684114112566*^9}, 
   3.946995370346033*^9, {3.947238621534724*^9, 3.947238656346195*^9}, 
   3.951495102179596*^9, 3.951495145799114*^9, {3.9514951801560917`*^9, 
   3.9514952564112587`*^9}},
 CellLabel->
  "In[1630]:=",ExpressionUUID->"2af47e21-c9c4-4366-a2d4-479e77cc1490"],

