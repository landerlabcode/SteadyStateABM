Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stochSim5c", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Last", "@", "\[IndentingNewLine]", 
       RowBox[{"Reap", "[", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Sow", "[", 
           RowBox[{"TotalLast", "@", 
            RowBox[{"NestWhileList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"StepUpAsynchronousP2", "[", 
                RowBox[{"#", ",", " ", "params10c"}], "]"}], "&"}], ",", " ", 
              
              RowBox[{"{", 
               RowBox[{"2", ",", "10"}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{
                 SuperscriptBox["10", "5"], ">", 
                 RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&&", 
                RowBox[{
                 RowBox[{"Last", "[", "#", "]"}], "<", 
                 SuperscriptBox["10", "5"]}]}], "&"}], ",", " ", "2", ",", 
              " ", "100"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", "100", "}"}]}], "]"}], "]"}]}], ",", "1"}], "]"}]}], 
   ";"}], "]"}]], "Input",
