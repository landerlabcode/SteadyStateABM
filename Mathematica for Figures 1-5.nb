Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "@", "Now"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stochSim10untotaled2", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Last", "@", "\[IndentingNewLine]", 
       RowBox[{"Reap", "[", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Sow", "[", 
           RowBox[{"NestWhileList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"StepUpAsynchronousP3", "[", 
               RowBox[{"#", ",", " ", "params12b"}], "]"}], "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{"300", ">", 
               RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&"}], ",", " ", 
             "1", ",", " ", "100"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", "100", "}"}]}], "]"}], "]"}]}], ",", "1"}], "]"}]}], 
   ";"}], "]"}]}], "Input",
