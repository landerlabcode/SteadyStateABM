   RowBox[{"k", "\[Rule]", "0.5`"}], ",", 
   RowBox[{"\[Lambda]", "\[Rule]", "22.5`"}], ",", 
   RowBox[{"\[Sigma]", "\[Rule]", "2.5`"}], ",", 
   RowBox[{"pbar", "\[Rule]", "0.9`"}], ",", 
   RowBox[{"tend", "\[Rule]", "200"}], ",", 
   RowBox[{"\[Delta]", "\[Rule]", "0.1`"}]}], "}"}]], "Output",
