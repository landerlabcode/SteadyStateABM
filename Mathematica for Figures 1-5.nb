Cell[BoxData[
 RowBox[{
  RowBox[{"stochSim1", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Last", "@", 
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Sow", "[", 
          RowBox[{"TotalLast", "@", 
           RowBox[{"NestWhileList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Apply", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"StepUpAsynchronousCF", "[", 
                  RowBox[{"#1", ",", " ", "#2", ",", 
                   RowBox[{"pbar", "/.", "params1"}], ",", 
                   RowBox[{"n1", "/.", "params1"}], ",", " ", "0", ",", " ", 
                   RowBox[{"\[Gamma]", "/.", "params1"}], ",", " ", "0", ",", 
                   " ", 
                   RowBox[{"d", "/.", "params1"}]}], "]"}], "&"}], ",", "#"}],
                "]"}], "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0"}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                SuperscriptBox["10", "4"], ">", 
                RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&&", 
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], "<", 
                SuperscriptBox["10", "4"]}]}], "&"}], ",", " ", "2", ",", " ",
              "100"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", "100", "}"}]}], "]"}], "]"}]}], ",", "1"}], "]"}]}], 
