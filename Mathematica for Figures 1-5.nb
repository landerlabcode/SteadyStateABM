Cell[CellGroupData[{

Cell["\<\
Figure 2 L, P (Spatial models, well mixed, stochastic simulations)\
\>", "Section",
 CellChangeTimes->{{3.9468529891937113`*^9, 3.94685302145364*^9}, 
   3.946854349506171*^9, 3.951398933196995*^9, 
