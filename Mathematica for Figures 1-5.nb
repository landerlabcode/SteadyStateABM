Cell[CellGroupData[{

Cell["Figure 5 B, E, H (Mixed feedback models, stream plots)", "Section",
 CellChangeTimes->{{3.9469932584026527`*^9, 3.9469932950082073`*^9}, 
   3.951867154279118*^9},ExpressionUUID->"0af4c35f-5fb7-4e2c-89c7-\
d83eb84fcfab"],

Cell["\<\
In the first and second models (system 2) stem cells inhibit inhibition from \
terminal cells.  In the third model (system 4), terminal cells inhibit their \
own inhibition.  \
\>", "Text",
 CellChangeTimes->{{3.9469933265416517`*^9, 3.9469933616318083`*^9}, {
  3.946993546997176*^9, 3.9469935587719183`*^9}, {3.9515192560004377`*^9, 
  3.951519261247287*^9}},ExpressionUUID->"56c8ce7d-5159-4f35-91b4-\
63207c7ea03e"],

