Cell[BoxData[
 RowBox[{
  RowBox[{"StepUpNew", "[", 
   RowBox[{"{", 
    RowBox[{"z_", ",", " ", "w_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", "=", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{"BinomialDistribution", "[", 
        RowBox[{
         RowBox[{"2", "z"}], ",", "0.5"}], "]"}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"w", "+", 
       RowBox[{"2", "z"}], "-", "x", "-", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"BinomialDistribution", "[", 
         RowBox[{"w", ",", "0.5"}], "]"}], "]"}]}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.932827334388637*^9, 3.9328274699637613`*^9}, {
  3.932827506189098*^9, 3.932827506369314*^9}, {3.932827572205439*^9, 
