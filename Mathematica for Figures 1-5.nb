Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n1", "=", "1"}], ",", "  ", 
     RowBox[{"\[Gamma]", "=", "0.000045"}], ",", " ", 
     RowBox[{"c0init", "=", "1"}], ",", " ", 
     RowBox[{"c1init", "=", "0"}], ",", " ", 
     RowBox[{"tmax", "=", "200"}], ",", " ", 
     RowBox[{"pbar", "=", "0.7"}], ",", " ", 
     RowBox[{"d", "=", "0.1"}]}], "}"}], ",", " ", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solset", "=", 
       RowBox[{"Flatten", "@", 
        RowBox[{"NDSolve", "[", 
         RowBox[{"system1", ",", " ", 
          RowBox[{"{", 
           RowBox[{"c0", ",", " ", "c1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "tmax"}], "}"}]}], "]"}]}]}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c1", "[", "t", "]"}], ",", 
           RowBox[{"c0", "[", "t", "]"}]}], "}"}], "/.", "solset"}], "]"}], 
       ",", 
