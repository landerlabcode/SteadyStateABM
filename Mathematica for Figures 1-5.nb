Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stochSim4", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Last", "@", "\[IndentingNewLine]", 
       RowBox[{"Reap", "[", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Sow", "[", 
           RowBox[{"TotalLast", "@", 
            RowBox[{"NestWhileList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"StepUpAsynchronousP1", "[", 
                RowBox[{"#", ",", " ", "params9"}], "]"}], "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"20", ",", "20"}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{
                 SuperscriptBox["10", "4"], ">", 
                 RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&&", 
                RowBox[{
                 RowBox[{"Last", "[", "#", "]"}], "<", 
                 SuperscriptBox["10", "4"]}]}], "&"}], ",", " ", "2", ",", 
              " ", "100"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", "50", "}"}]}], "]"}], "]"}]}], ",", "1"}], "]"}]}], 
