Cell[BoxData[
 RowBox[{
  RowBox[{"CreateBaseTable", "[", "\[Lambda]_", "]"}], ":=", " ", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ulq", "=", 
       RowBox[{"Chop", "[", " ", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "\[Lambda]"}]], " ", 
         RowBox[{"BesselI", "[", 
          RowBox[{"1", ",", 
           FractionBox["1", 
            RowBox[{"2", "\[Lambda]"}]]}], "]"}], " ", "*", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"N", "@", 
            RowBox[{"BesselK", "[", 
             RowBox[{"0", ",", 
              FractionBox[
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"x", "-", "801"}], ")"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"y", "-", "801"}], ")"}], "2"]}]], "\[Lambda]"]}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "1", ",", " ", "800"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"y", ",", "1", ",", " ", "800"}], "}"}]}], "]"}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"leftrow", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{"N", "@", 
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{
            FractionBox["1", 
             RowBox[{"2", "\[Lambda]"}]], " ", 
            RowBox[{"BesselI", "[", 
             RowBox[{"1", ",", 
              FractionBox["1", 
               RowBox[{"2", "\[Lambda]"}]]}], "]"}], " ", 
            RowBox[{"BesselK", "[", 
             RowBox[{"0", ",", 
              FractionBox[
               SqrtBox[
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"y", "-", "801"}], ")"}], "2"]], "\[Lambda]"]}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"y", ",", " ", "1", ",", " ", "800"}], "}"}]}], "]"}]}], 
        "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"ulq", ",", " ", 
           RowBox[{"{", "leftrow", "}"}], ",", " ", 
           RowBox[{"Reverse", "[", "ulq", "]"}]}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"Join", "[", 
          RowBox[{"leftrow", ",", " ", 
           RowBox[{"{", "0", "}"}], ",", " ", 
           RowBox[{"Reverse", "[", "leftrow", "]"}]}], "]"}], "}"}], ",", 
        RowBox[{"Reverse", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"ulq", ",", " ", 
            RowBox[{"{", "leftrow", "}"}], ",", " ", 
            RowBox[{"Reverse", "[", "ulq", "]"}]}], "]"}], "]"}], "]"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"1601", ",", " ", "1601"}], "}"}]}], "]"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.912514518486782*^9, 3.912514717168313*^9}, {
