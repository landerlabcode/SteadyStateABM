      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"1", "-", "p"}]}], "}"}], "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
